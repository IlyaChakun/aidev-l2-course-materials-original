# Copy this file to .env (it is in .gitignore and never gets into git). Fill in the values by hand.
# FORMAT RULES: KEY=value without quotes, no spaces around "=", no $ sign in values (both make and bash read this file).
# Never paste secrets into a chat. The agent uses them only as environment variables through make and the scripts.

# ============ DB and server (safe defaults) ============
SUPPORT_DB_PATH=./data/support.sqlite
# stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_LOG_LEVEL=INFO

# ============ LLM: OpenAI (later modules) ============
OPENAI_API_KEY=
# You choose the model name; it is not hardcoded in the repository
OPENAI_MODEL=
# Optional: an OpenAI-compatible endpoint instead of api.openai.com
OPENAI_BASE_URL=

# ============ M2: RAG (Qdrant, embeddings) ============
QDRANT_URL=http://localhost:6333
# Only if Qdrant is protected by a key (Qdrant Cloud); leave empty for local Docker
QDRANT_API_KEY=
# The same embedding model for ingestion and search; you choose the name (the same OPENAI_API_KEY works)
EMBEDDING_MODEL=

# ============ M2 (block B), M3–M5: other providers, if needed ============
ANTHROPIC_API_KEY=

# ============ M6: Langfuse tracing ============
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com, self-hosted: http://localhost:3000
LANGFUSE_BASE_URL=
