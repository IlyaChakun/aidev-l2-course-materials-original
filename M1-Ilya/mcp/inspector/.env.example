# Copy to .env (it is not committed). Everything is optional: without a token the server simply does not make it into the catalog.

# Inspector port on 127.0.0.1. 6380 rather than the standard 6274: that one is often taken by another Inspector.
INSPECTOR_PORT=6380
# A permanent token so a bookmarked link survives restarts. Empty means a new one on every start.
INSPECTOR_TOKEN=

# GitHub MCP (read-only): a fine-grained PAT with read access to the repositories you need.
GITHUB_TOKEN=
# Framelink Figma: Figma → Settings → Security → Personal access tokens.
FIGMA_API_KEY=

# A copy of smart-support for the support-tickets server. Default ~/sts-demo/sts-m1
# from ../demo/demo-setup.sh setup.
STS_DIR=
