      "webhookId": "d05c4a70-0000-4000-8000-000000000005"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You are the support assistant of Lumen, a SaaS for order tracking and reports.\n\nRules:\n1. Before answering, ALWAYS call the tool lumen_knowledge_base with a short English search query built from the key terms of the question. You may call it once more with a different query if the first passages do not cover the question.\n2. Answer ONLY from the passages the tool returned. Never use general knowledge, never guess numbers, names, prices or steps.\n3. Refusal: if the thing asked about (a feature, integration, setting) does not appear in the passages at all, begin the reply with exactly `I could not find this in the Lumen knowledge base.` After that you may add at most one sentence with what the passages do say on the topic. Never invent steps. Do NOT refuse when the passages contain the facts needed, even if you have to combine two documents or compare a number from the question with a limit from a table.\n4. End every reply with one line `Sources: <file>.md, <file>.md` listing each metadata.source you actually used, each file name only once (no repeats). If you used nothing, write `Sources: none`.\n5. Reply in the language of the question, briefly (up to 6 sentences).",
          "maxIterations": 5,
          "returnIntermediateSteps": true
        }
      },
      "id": "1c2e6d2f-6b02-4d22-8b02-000000000002",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "responsesApiEnabled": false,
        "options": {
          "temperature": 0
        }
      },
      "id": "1c2e6d2f-6b02-4d22-8b02-000000000003",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        120,
        560
      ],
      "credentials": {
        "openAiApi": {
          "id": "demo05OpenAi",
          "name": "OpenAI (demo 05)"
        }
      }
    },
    {
      "parameters": {
        "contextWindowLength": 6
      },
      "id": "1c2e6d2f-6b02-4d22-8b02-000000000004",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        300,
        560
      ]
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Search the Lumen help-center and policy knowledge base (account, billing, plans, refunds, errors, reports, integrations, privacy, SLA). Input: one short English search query. Returns up to 5 passages; metadata.source is the file name to cite.",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "lumen_kb"
        },
        "topK": 5,
        "includeDocumentMetadata": true,
        "options": {}
      },
