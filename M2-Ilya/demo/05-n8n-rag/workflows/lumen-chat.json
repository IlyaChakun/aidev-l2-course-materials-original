{
  "id": "demo05LumenChat",
  "name": "Demo 05 · Lumen support chat (RAG)",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "options": {
          "responseMode": "lastNode"
        }
      },
      "id": "1c2e6d2f-6b02-4d22-8b02-000000000001",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
