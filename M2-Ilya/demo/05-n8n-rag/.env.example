# Copy to .env (gitignored) or export the variables in your shell.
# The key is read only at `make setup` and goes straight into n8n's encrypted credential store.
OPENAI_API_KEY=

# Fixed demo value: lets the n8n volume survive container re-creation. Not a production secret.
DEMO05_ENCRYPTION_KEY=m2-demo-05-n8n-rag-not-a-secret

# Local owner account of this demo n8n (loopback only).
DEMO05_EMAIL=demo@example.com
DEMO05_PASSWORD=Demo05Lumen2026

# Host ports (loopback only).
DEMO05_N8N_PORT=5681
DEMO05_QDRANT_PORT=6381
DEMO05_QDRANT_GRPC_PORT=6382
