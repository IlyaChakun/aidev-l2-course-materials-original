# Copy to .env (it is git-ignored) or export in the shell. The Makefile reads .env if it exists.
# The key is needed only for `make warm` (first run). After that every step works from data/cache.
OPENAI_API_KEY=

# Optional overrides. Names are demo-specific on purpose: a generic QDRANT_URL from another
# project must not redirect the demo to a different Qdrant.
# DEMO_QDRANT_URL=http://localhost:6341
# DEMO_COLLECTION=lumen_demo
# DEMO_WIDTH=140
