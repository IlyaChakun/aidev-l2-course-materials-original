    {
      "parameters": {
        "jsCode": "// Get the data from the previous node\nconst items = $input.all();\n\n// Supabase usually returns an array directly\nlet searchResults;\n\n// Try different structure variants\nif (Array.isArray(items[0]?.json)) {\n  // If it is an array inside json\n  searchResults = items[0].json;\n} else if (items[0]?.json?.data) {\n  // If the data is in the data property\n  searchResults = items[0].json.data;\n} else if (items.length > 1) {\n  // If each item is a separate result\n  searchResults = items.map(item => item.json);\n} else {\n  // If it is just an object\n  searchResults = [items[0].json];\n}\n\nconst userQuery = $('When Executed by Another Workflow').first().json.query;\n\n// Prepare data for Cohere Rerank\nconst documents = searchResults.map(item => item.content);\nconst documentIds = searchResults.map(item => item.id);\n\nreturn {\n  json: {\n    model: \"rerank-v3.5\",\n    query: userQuery,\n    top_n: 5,\n    documents: documents\n  },\n  // Keep the original data\n  pairedData: {\n    originalResults: searchResults,\n    documentIds: documentIds\n  }\n};"
      },
