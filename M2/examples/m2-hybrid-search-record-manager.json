        "query": "select \n  id,\n  content,\n  vector_score,\n  keyword_score,\n  vector_rank,\n  keyword_rank,\n  final_score\nfrom match_hybrid_documents_with_details(\n  '{{ $('When Executed by Another Workflow').item.json.query }}',\n  '[{{ $json.data[0].embedding }}]'::vector(1536),\n  10\n);",
