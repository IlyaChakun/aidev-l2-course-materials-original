    {
      "parameters": {
        "jsCode": "// Get the results from Cohere\nconst cohereData = $input.first().json;\nconst rerankResults = cohereData.results;\n\n// Get the data directly from the \"Execute a SQL query\" node\nconst sqlResults = $('Execute a SQL query').all();\nconst searchResults = sqlResults.map(item => item.json);\n\nconsole.log('Rerank results:', rerankResults.length);\nconsole.log('Original search results:', searchResults.length);\n\n// Map the results by index\nconst finalResults = rerankResults.map((reranked, position) => {\n  const originalDoc = searchResults[reranked.index];\n  \n  if (!originalDoc) {\n    console.error('Document not found at index:', reranked.index);\n    return null;\n  }\n  \n  return {\n    id: originalDoc.id,\n    content: originalDoc.content,\n    vector_score: originalDoc.vector_score,\n    keyword_score: originalDoc.keyword_score,\n    vector_rank: originalDoc.vector_rank,\n    keyword_rank: originalDoc.keyword_rank,\n    hybrid_final_score: originalDoc.final_score,\n    rerank_score: reranked.relevance_score,\n    rerank_position: position + 1,\n    original_index: reranked.index\n  };\n}).filter(item => item !== null);\n\nreturn finalResults.map(item => ({ json: item }));"
      },
